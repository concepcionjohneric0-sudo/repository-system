<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Repository System</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 16px; }
    form.create-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px; padding: 16px; border: 1px solid #ddd; border-radius: 6px; }
    input, textarea, button { padding: 10px; font-size: 14px; }
    button { cursor: pointer; background: #198754; color: #fff; border: none; border-radius: 4px; }
    .repo-card { border: 1px solid #ccc; padding: 14px; border-radius: 6px; margin-bottom: 12px; }
    .actions { display: flex; gap: 8px; align-items: center; margin-top: 10px; }
    .edit-btn { padding: 8px 12px; background: #0d6efd; color: #fff; text-decoration: none; border-radius: 4px; font-size: 14px; }
    .delete-form { border: none; padding: 0; margin: 0; }
    .delete-btn { background: #dc3545; padding: 8px 12px; font-size: 14px; }
  </style>
</head>
<body>
  <h1>Repository System</h1>

  <form class="create-form" action="/repositories" method="POST">
    <input type="text" name="title" placeholder="Title ng repository / document" required />
    <textarea name="description" placeholder="Description" rows="3" required></textarea>
    <input type="text" name="fileUrl" placeholder="File URL o link (hal. https://...)" required />
    <button type="submit">Save Repository</button>
  </form>

  <h2>Saved Repositories (<%= repos.length %>)</h2>
  <% if (repos.length === 0) { %>
    <p>Wala pang nakalagay na repository item.</p>
  <% } else { %>
    <% repos.forEach(repo => { %>
      <div class="repo-card">
        <h3><%= repo.title %></h3>
        <p><%= repo.description %></p>
        <p><strong>Link:</strong> <a href="<%= repo.fileUrl %>" target="_blank"><%= repo.fileUrl %></a></p>

        <div class="actions">
          <a href="/repositories/<%= repo._id %>/edit" class="edit-btn">Edit</a>

          <form class="delete-form" action="/repositories/<%= repo._id %>/delete" method="POST">
            <button type="submit" class="delete-btn">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>
</body>
</html>